{
  "name": "harness-qq-toolkit",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretest": "node -e \"require('node:fs').mkdirSync('tmp',{recursive:true})\"",
    "test": "node scripts/test.cjs",
    "test:audit": "node scripts/test.cjs --audit",
    "portable": "node scripts/portable.cjs",
    "test:patch": "node maintenance/build-qqbot-patch.cjs --check && node maintenance/build-qqbot-patch.cjs --sdk --check && node maintenance/audit/verify-patches.cjs"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "js-yaml": "4.1.1",
    "pnpm": "11.7.0",
    "@tencent-connect/dsh-qqbot": "0.5.2",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
